{
  "name": "vortexa-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && npm run test:compiled",
    "test:compiled": "node scripts/run-tests.mjs",
    "test:unit": "npm run build && node --test dist/tests/domain.test.js dist/tests/vault-use-cases.test.js dist/tests/redis-coordination-adapter.test.js dist/tests/notification-outbox.test.js",
    "test:integration": "npm run build && node --test dist/tests/configuration.test.js dist/tests/postgres-repositories.test.js dist/tests/manifest-abi.test.js",
    "test:security": "npm run build && node --test dist/tests/api-security.test.js dist/tests/redis-coordination-adapter.test.js",
    "check": "npm run scan:secrets && npm run check:boundaries && npm run lint && npm run format:check && npm run typecheck && npm run typecheck:railway && npm run test:compiled && npm run verify:release:static",
    "ci": "npm run check && npm run audit:production",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".railway/**/*.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \".railway/**/*.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \".github/**/*.yml\"",
    "typecheck:railway": "tsc -p tsconfig.railway.json --pretty false",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "migrate": "npm run build && node scripts/migrate.mjs up",
    "migrate:down": "npm run build && node scripts/migrate.mjs down",
    "verify:live:infrastructure": "npm run build && node scripts/verify-infrastructure-live.mjs",
    "verify:live:contract-wiring": "npm run build && node scripts/verify-contract-wiring.mjs",
    "verify:live:artifacts": "python scripts/verify-artifact-equivalence.py",
    "verify:production:schema": "npm run build && node scripts/check-production-schema.mjs",
    "indexer:start": "node dist/apps/indexer/src/main.js",
    "outbox:start": "node dist/apps/outbox/src/main.js",
    "indexer:reconcile": "npm run build && node scripts/indexer-reconcile.mjs",
    "indexer:replay": "npm run build && node scripts/indexer-replay.mjs --",
    "verify:staging:indexer-reorg": "npm run build && node scripts/verify-indexer-reorg-staging.mjs",
    "verify:deployment-blocks": "npm run build && node scripts/find-deployment-blocks.mjs",
    "verify:live:indexer": "npm run build && node scripts/verify-indexer-live.mjs",
    "verify:live:projections": "npm run build && node scripts/verify-projections-live.mjs",
    "verify:live:contracts": "node scripts/verify-contract-deployments.mjs",
    "inspect:config": "npm run build && node scripts/inspect-service-configuration.mjs",
    "inspect:operations": "npm run build && node scripts/inspect-operational-state.mjs",
    "inspect:timelock": "npm run build && node scripts/inspect-timelock-governance.mjs",
    "smoke:production": "node scripts/verify-production-smoke.mjs",
    "verify:release:static": "node scripts/verify-release-static.mjs",
    "clean": "tsc -b --clean",
    "start": "node dist/apps/api/src/main.js",
    "dev": "npm run build && npm run start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "railway": "^3.16.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "viem": "^2.57.14"
  }
}

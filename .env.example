# Copy this file to .env for local development. Never commit .env or put secrets here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ACTIVE_CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://your-sepolia-provider.example
# Optional comma-separated read-only RPC failover providers.
# SEPOLIA_RPC_URLS=https://primary.example,https://secondary.example
RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=1
RPC_CONFIRMATIONS=12
# Use Railway private URLs when running inside Railway; local development may use approved external URLs.
DATABASE_URL=REPLACE_WITH_POSTGRES_URL
REDIS_URL=REPLACE_WITH_REDIS_URL
# Local: http://localhost:5173,http://127.0.0.1:5173
# Railway production: set this same key to the exact HTTPS frontend origin(s) in Railway variables.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-to-server only; use a random value of at least 32 characters in production.
INTERNAL_API_KEY=REPLACE_WITH_A_RANDOM_INTERNAL_API_KEY
# Set true only when every request is behind a trusted reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
# Public API cap; chain and contract status retain fixed stricter caps (30 and 10).
GLOBAL_RATE_LIMIT=60
M7_READ_RATE_LIMIT=30
M7_EVENT_RATE_LIMIT=15
M7_WALLET_RATE_LIMIT=20
MAX_REQUEST_BODY_BYTES=16384
# Maximum time for active requests to drain after SIGTERM/SIGINT.
SHUTDOWN_GRACE_PERIOD_MS=15000
M7_PAGE_DEFAULT=25
M7_PAGE_MAX=50
M7_STALE_AFTER_BLOCKS=25
M7_VAULT_LIST_CACHE_TTL_SECONDS=15
M7_VAULT_DETAIL_CACHE_TTL_SECONDS=10
M7_VAULT_EVENTS_CACHE_TTL_SECONDS=10
M7_POSITIONS_CACHE_TTL_SECONDS=5
LOG_LEVEL=info
# The blockchain indexer is a separate process and remains disabled until its policies are approved.
INDEXER_ENABLED=false
INDEXER_START_BLOCK=12032363
INDEXER_BATCH_SIZE=500
INDEXER_HEADER_CONCURRENCY=10
INDEXER_POLL_INTERVAL_MS=12000
INDEXER_CONFIRMATIONS=12
INDEXER_MAX_REORG_DEPTH=128
INDEXER_WORKER_ID=REPLACE_WITH_UNIQUE_WORKER_ID
CONTRACT_MANIFEST_PATH=packages/contracts/manifests/sepolia-v1.json
# Required deployment addresses for the selected chain.
CONTRACT_PRICE_GUARD=0x5288B03FA0d74a7fE2d59611C360E50E77aC4bE3
CONTRACT_SHAPE_LIBRARY=0xBc6D0A524d5DF7C6b86648564b05277d49B5c213
CONTRACT_TIMELOCK_CONTROLLER=0x93Ee400618912Ef2b29Aa82e593db1a04850f355
# This is the Vault implementation, not a factory-created user Vault.
CONTRACT_VAULT=0x258D4A053d9007F00e509088d79E0b99C9C47A1e
CONTRACT_VAULT_FACTORY=0xA7dc22764A76e776a75bf7bBbe37169ae2CC45B2
CONTRACT_VAULT_LENS=0x8d6F15c321135bc62247DFed56868E4EEB9D2745
CONTRACT_FEE_COLLECTOR=0x2a48Ea5eC70e4429598f3B5F3E159d36376268a0
CONTRACT_NORMAL_LP_STRATEGY=0x1a9D81a0a6e1574650578e95ef720C1dc18125e1
CONTRACT_BUY_THE_DIP_STRATEGY=0x6eFd1301eb2d9824b587E77A56122656D878c8C0
CONTRACT_SELL_THE_PUMP_STRATEGY=0xd20C9B835CCBf2F0BAd63bD3461D23Ed1C7D3ED5
CONTRACT_SWAP_EXECUTOR=0x07696dbD853DBc6F713fb2B18AbaC96eE2085069
CONTRACT_ZAP=0xd40eC68130fb7908739400E4E52972D3933a20B6
CONTRACT_AUTOMATION_TANK=0x2cfD5B064cd4bFBFd50808Ad91f6CA4b2DDFcd0D
CONTRACT_VAULT_M6_MODULE=0x0423b71524324a2bf2f225EbAc066417C455dD2b
CONTRACT_VAULT_M5_MODULE=0xeD0cdc5f4ebD5D0a9F49d1029464Bc1B8ba99130

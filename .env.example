# Copy to .env. NEVER commit .env. Rotate the credentials previously shared in chat.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CHAIN_ID=11155111
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional comma-separated providers for failover. When set, this supersedes SEPOLIA_RPC_URL.
# SEPOLIA_RPC_URLS=https://primary.example,https://secondary.example
RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=1
RPC_CONFIRMATIONS=12
# Railway PUBLIC proxy URLs required when connecting from Windows or a separate PM2 server.
# The *.railway.internal endpoints only resolve within Railway's private network.
DATABASE_URL=REPLACE_WITH_RAILWAY_PUBLIC_POSTGRES_URL
REDIS_URL=REPLACE_WITH_RAILWAY_PUBLIC_REDIS_URL
# Browser origins are exact matches. Production origins must use HTTPS.
CORS_ALLOWED_ORIGINS_DEVELOPMENT=http://localhost:5173
CORS_ALLOWED_ORIGINS_PRODUCTION=https://app.example.com
# Server-to-server only; use a randomly generated value of at least 32 characters in production.
INTERNAL_API_KEY=REPLACE_WITH_A_RANDOM_INTERNAL_API_KEY
# Enable only behind a trusted reverse proxy such as Railway/Nginx.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SECONDS=60
NETWORK_RATE_LIMIT=60
CHAIN_RATE_LIMIT=30
CONTRACT_STATUS_RATE_LIMIT=10
# Select a reviewed, read-only deployment manifest; do not override addresses with environment variables.
CONTRACT_MANIFEST_PATH=packages/contracts/manifests/sepolia-v1.json
